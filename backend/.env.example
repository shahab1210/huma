# MongoDB
MONGO_URI=mongodb://localhost:27017/huma_mehendi

# JWT
JWT_SECRET=your_jwt_secret_change_this_in_production
JWT_EXPIRE=24h



# Cloudinary (optional)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# WhatsApp Cloud API (Meta) — see docs/WHATSAPP_SETUP.md
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_OTP_TEMPLATE_NAME=huma_otp_verification
# Google OAuth — see docs/GOOGLE_OAUTH_SETUP.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OTP Configuration
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_REQUESTS_PER_NUMBER=10

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:8443

# Server
PORT=5000
NODE_ENV=development

# Cron Secret
CRON_SECRET_KEY=your_cron_secret_key
